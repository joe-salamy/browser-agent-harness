{
  "name": "browser-agent-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "demo:seed": "dotenv -e .env.local -- prisma migrate dev --name init && dotenv -e .env.local -- prisma db seed",
    "skill-chain:create": "tsx scripts/create-skill-chain.ts",
    "skill-chain": "tsx scripts/run-skill-chain.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.2",
    "@aws-sdk/client-s3": "3.1068.0",
    "@prisma/client": "6.16.3",
    "bcryptjs": "3.0.3",
    "next": "16.2.9",
    "next-auth": "4.24.14",
    "openai": "6.42.0",
    "prisma": "6.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
